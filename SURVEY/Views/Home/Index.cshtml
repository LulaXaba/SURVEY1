@model SurveyModel
@{
    ViewData["Title"] = "Home Page";
}
<style>
/* Light blue border for checkboxes */
.form-check-input {
    border: 2px solid #ADD8E6;
}

.form-check-input:focus {
    border-color: #ADD8E6;
    box-shadow: 0 0 0 0.2rem rgba(173, 216, 230, 0.5);
}

.form-check {
    margin-right: 20px;
}

/* Custom grey header for thead */
thead.table-grey {
    background-color: grey;
    color: white; /* Changed from gray to white for better contrast */
}

    #DateOfBirth {
        color: transparent;            /* hide text */
        background-color: transparent;
        border: none;
        cursor: text;
        height: 25px !important;
        pointer-events: auto;          /* keep it clickable */
    display: ;}

    #DateOfBirth::-webkit-calendar-picker-indicator {
        opacity: 0;                   /* hide calendar icon */
    }

    #DateOfBirth:focus {
        color: black !important;      /* show text */
        background-color: white !important;
        border: 1px solid #ADD8E6 !important;
        outline: none;
    }

    #DateOfBirth:focus::-webkit-calendar-picker-indicator {
        opacity: 1;                   /* show calendar icon on focus */
    }

/* Style the entire table */
table {
    width: 100%; /* Full width */
    border-collapse: collapse; /* Remove double borders */
    margin-top: 20px; /* Add spacing above table */
    font-family: Arial, sans-serif;
    background-color: #fff; /* White background */
}
 
/* Style all table cells */
th, td {
    border: 1px solid #d0e7f9; /* Light blue border */
    padding: 12px;
    text-align: center; /* Center align radio buttons and headers */
}
 
/* Style table header cells */
th {
    background-color: rgb(105, 117, 128); /* Light grey-blue background */
    color: #333; /* Dark text */
    font-weight: normal;
}
 
/* Left-align the first column (question text) */
td:first-child {
    text-align: left;
    font-weight: normal;
}
 
/* Style unselected radio buttons */
input[type="radio"] {
    appearance: none; /* Remove default styling */
    -webkit-appearance: none;
    background-color: #fff;
    border: 1px solid #5bc0de; /* Light blue border */
    border-radius: 50%; /* Make it round */
    width: 16px;
    height: 16px;
    cursor: pointer;
    position: relative;
    display: inline-block;
    vertical-align: middle;
}
 
/* Style the inner filled circle when selected */
input[type="radio"]:checked::before {
    content: '';
    position: absolute;
    top: 3px;
    left: 3px;
    width: 8px;
    height: 8px;
    background-color: #5bc0de; /* Light blue inner circle */
    border-radius: 50%;
}


/* Thinner custom radio buttons */
.custom-radio input[type="radio"] {
    appearance: none;
    -webkit-appearance: none;
    background-color: #fff;
    border: 1px solid #5bc0de;
    border-radius: 50%;
    width: 14px;
    height: 14px;
    position: relative;
    cursor: pointer;
}

.custom-radio input[type="radio"]:checked::before {
    content: '';
    position: absolute;
    top: 3px;
    left: 3px;
    width: 6px;
    height: 6px;
    background-color: #5bc0de;
    border-radius: 50%;
}

th, td {
    font-weight: normal !important;
}

    .custom-submit-btn {
        background-color: #00aaff !important;  /* Brighter blue */
        color: white !important;
        font-size: 10px;
        border: none;
        border-radius: 4px !important;
        padding: 6px 30px;
        margin-left: -400px;
        cursor: pointer; /* <-- Ensures it doesn't look disabled */
        opacity: 1;       /* <-- Ensures full visibility */
        transition: background-color 0.3s ease;
    }

    .custom-submit-btn:hover {
        background-color: #008ecc !important; /* Darker on hover */
    }



</style>


</nav>


